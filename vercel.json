{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/admin/",
            "destination": "/admin",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/admin/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}